#pragma once

// Copiar este archivo como secrets.h (no subir secrets.h al repositorio).
// API_URL debe incluir el protocolo y la ruta completa, por ejemplo:
// https://tu-servidor.example/api/lecturas
constexpr char WIFI_SSID[] = "TU_WIFI";
constexpr char WIFI_PASSWORD[] = "TU_CLAVE_WIFI";
constexpr char API_URL[] = "https://TU_SERVIDOR/api/lecturas";
constexpr char API_KEY_SENSOR[] = "LA_MISMA_API_KEY_SENSOR_DEL_SERVIDOR";

// Certificado raíz CA del servidor HTTPS (PEM). Obtenerlo para el dominio real
// y pegarlo entre R"CERT(... )CERT". No usar setInsecure() en instalaciones.
constexpr char ROOT_CA_CERT[] = R"CERT(
-----BEGIN CERTIFICATE-----
PEGAR_AQUI_EL_CERTIFICADO_RAIZ_CA
-----END CERTIFICATE-----
)CERT";
